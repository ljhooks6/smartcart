{
  "name": "mealcaddie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "set NEXT_TEST_WASM_DIR=.\\node_modules\\@next\\swc-wasm-nodejs&& next dev",
    "build": "set NEXT_TEST_WASM_DIR=.\\node_modules\\@next\\swc-wasm-nodejs&& next build",
    "start": "set NEXT_TEST_WASM_DIR=.\\node_modules\\@next\\swc-wasm-nodejs&& next start",
    "lint": "next lint",
    "test:grocery": "node --experimental-strip-types --test tests/grocery-reliability.test.mjs",
    "test:week": "node --experimental-strip-types --test tests/week-progress.test.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/meal-recovery.test.mjs",
    "test:save": "node --experimental-strip-types --test tests/save-recovery.test.mjs",
    "test:shopping": "node --experimental-strip-types --test tests/shopping-progress.test.mjs"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^15.5.14",
    "@supabase/supabase-js": "^2.103.3",
    "@vercel/queue": "0.8.0",
    "next": "^15.0.0",
    "openai": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
